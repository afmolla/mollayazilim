# Yerel IIS: http://localhost/ (port 80) — NEXT_PUBLIC_SITE_URL=http://localhost

# --- Üretim (mollayazilim.com) ---
# Bu dosyayı kopyalayıp sunucuda .env.production.local olarak kullanın (Git'e eklemeyin).

# Canlı domain kökü (sonek /kuafor kod tarafından eklenir — tek projede basePath)
# Vercel’de MUTLAKA tanımlayın; yoksa robots.txt Host satırı localhost görünür.
NEXT_PUBLIC_SITE_URL=https://mollayazilim.com

# Yerelde demo kartları panelde kapalı olsa bile görünür. Panel bayraklarını test etmek için koyun:
# NEXT_PUBLIC_RESPECT_DEMO_FLAGS=1

# Panel üstündeki "Siteye dön" — PHP vitrin (kuafor-php) kullanıyorsanız tam URL:
# NEXT_PUBLIC_SITE_HOME_URL=https://mollayazilim.com/kuafor-php/anasayfa

# Çerezin Secure bayrağı: NEXT_PUBLIC_SITE_URL https ise otomatik true olur.
# Özel durumda elle: SESSION_COOKIE_SECURE=true

# Marka adı (sayfa başlığı, JSON-LD, panel varsayılanları)
NEXT_PUBLIC_SALON_AD=Mollayazilim

# WhatsApp (ülke kodu ile sadece rakam)
NEXT_PUBLIC_WHATSAPP_SALON=905551234567

# Panel şifresi — üretimde güçlü ve benzersiz (tüm vitrin panellerinde aynı değer kontrol edilir)
PANEL_PASSWORD=

# Panel oturumu: hareketsiz kalınca süre düşer (saniye). Varsayılan 600 = 10 dk. Kaydırmalı yenileme (sayfa/API istekleri uzatır).
# PANEL_SESSION_IDLE_SECONDS=600

# Oturum imzası — üretimde en az 32 karakter rastgele (openssl rand -hex 32)
SESSION_SECRET=

# Mobil (Expo) → Next API CORS; geliştirmede * serbest. Üretimde tek origin yazın.
# MOBILE_CORS_ORIGIN=https://mollayazilim.com

# --- SEO (Search Console / doğrulama — opsiyonel) ---
# Google Search Console → Özellik ayarları → Doğrulama meta etiketi içeriği
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Yandex Webmaster doğrulama kodu
# NEXT_PUBLIC_YANDEX_VERIFICATION=

# Google Analytics 4 — ölçüm ID (G-XXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
