{
  "name": "kuafor-demo-build",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node scripts/clean-next.cjs",
    "dev": "next dev",
    "build": "next build --webpack",
    "notify": "node scripts/notify-done.cjs",
    "build:notify": "npm run build && node scripts/notify-done.cjs Build bitti",
    "rebuild:notify": "npm run rebuild && node scripts/notify-done.cjs Rebuild bitti",
    "rebuild": "npm run clean && npm run build",
    "start": "next start",
    "lint": "eslint --cache --cache-location .next/cache/eslint --ext .ts,.tsx \"app\" \"components\" \"lib\" --max-warnings=0"
  },
  "dependencies": {
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
