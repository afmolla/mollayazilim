# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# runtime analytics (hit logs should not be versioned)
/data/*/analytics.json
/data/*/analytics.hits.jsonl

# Let's Encrypt challenge files (runtime)
/.well-known/

# simple-acme downloaded by deploy/KUR-HTTPS.ps1
/deploy/simple-acme/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Android APK dağıtımı (public kökünden servis; binary repoda tutulmaz)
/public/apk/*.apk
