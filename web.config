<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS: URL Rewrite + Application Request Routing (ARR).
  ARR → Server Proxy Settings → Enable proxy = true.

  Domain (örn. mollayazilim.com):
    - DNS A/AAAA kaydı sunucu IP’sine
    - IIS’te site binding: https mollayazilim.com (sertifika: Let’s Encrypt / PFX)
    - Uygulama kökü: bu web.config + .next klasörü + node_modules
    - Ortam: NEXT_PUBLIC_SITE_URL=https://mollayazilim.com (.env.production.local)

  Next.js (aynı sunucu):
    - npm ci
    - npm run build
    - set NODE_ENV=production
    - npm run start  (varsayılan port 3000, 127.0.0.1 — ARR buraya proxyler)

  Süreç olarak kalıcı çalıştırma: nssm / PM2 / Windows Görev Zamanlayıcı ile node başlatın.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <!-- URL Rewrite ile serverVariables set edebilmek için allow list -->
      <allowedServerVariables>
        <add name="HTTP_X_FORWARDED_PROTO" />
        <add name="HTTP_X_FORWARDED_HOST" />
        <add name="HTTP_X_FORWARDED_FOR" />
      </allowedServerVariables>
      <rules>
        <rule name="NextReverseProxy" stopProcessing="true">
          <match url="(.*)" />

          <!-- Forward scheme/host to Node -->
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
          </serverVariables>

          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
        <httpErrors errorMode="Detailed" />
  </system.webServer>
</configuration>
