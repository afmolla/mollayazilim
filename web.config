<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS :80 -> Node 127.0.0.1:3000 (ic port, disariya acik degil)
  ACME: .well-known dosyalari once disk/Node, sonra genel proxy
-->
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <defaultDocument enabled="false" />
    <staticContent>
      <remove fileExtension="." />
      <mimeMap fileExtension="." mimeType="text/plain" />
    </staticContent>
    <rewrite>
      <rules>
        <!-- Let's Encrypt: kok .well-known dosyasi varsa IIS statik sunar -->
        <rule name="AcmeStaticRoot" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/(.+)$" />
          <conditions>
            <add input="{APPL_PHYSICAL_PATH}.well-known\acme-challenge\{R:1}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>
        <!-- public/.well-known dosyasi varsa IIS statik sunar -->
        <rule name="AcmeStaticPublic" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/(.+)$" />
          <conditions>
            <add input="{APPL_PHYSICAL_PATH}public\.well-known\acme-challenge\{R:1}" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="public/.well-known/acme-challenge/{R:1}" />
        </rule>
        <!-- yedek: Node uzerinden sun -->
        <rule name="AcmeNode" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/(.*)$" />
          <action type="Rewrite" url="http://127.0.0.1:3000/.well-known/acme-challenge/{R:1}" appendQueryString="false" />
        </rule>
        <rule name="NextProxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
