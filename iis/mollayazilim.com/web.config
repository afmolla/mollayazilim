<?xml version="1.0" encoding="UTF-8"?>
<!--
  Statik “yapım aşamasında” sayfası — IIS varsayılan belge: index.html
  HTTPS binding ve sertifikayı IIS Yöneticisi veya Install-MollayazilimSite.ps1 notlarından ekleyin.
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
